<?xml version="1.0" encoding="utf-8"?>
<!--
  应用内更新（2026-10-16）：只把**下载目录**开放给 FileProvider。

  ⚠ 只列 `update/` 这一个子目录，不要写 `<external-path path="." />` 之类 ——
    对外开放的范围越小越好（FileProvider 一旦配宽，等于把应用私有文件的可读面扩大了）。
  ⚠ `cache-path` 对应 `context.getCacheDir()`，下载的 APK 就放那儿；
    放 cache 而不是 files：装完/失败后由系统自动回收，不用自己清理。
-->
<paths>
    <cache-path name="update" path="update/" />
</paths>
